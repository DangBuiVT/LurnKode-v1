# ==============================================================================
# LurnKode — Assessment Microservice (M3) Environment Variables
# Refer to docs/guides/environment-setup.md for platform conventions.
# Copy to .env for local development (do not commit actual secrets to Git).
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4003
HOST=0.0.0.0

# Database (Dedicated PostgreSQL instance for M3 - Database-per-Service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lurnkode_assessment?schema=public

# Task Queue & Events (Redis + BullMQ)
REDIS_URL=redis://localhost:6380

# Inter-Service Communication (M2 Course Service RPC)
M2_COURSE_SERVICE_URL=http://localhost:4002
M2_REQUEST_TIMEOUT_MS=500

# Security & Internal Tokens
INTERNAL_SERVICE_TOKEN=m3-internal-secret-token
JWT_PUBLIC_KEY=
