# ============================================
# M1 — Auth Service · Environment Variables
# ============================================
# Copy file này thành .env và điền giá trị thực.
# KHÔNG commit file .env vào git.

# ============================================
# DATABASE (PostgreSQL — M1 schema riêng)
# ============================================
DATABASE_URL=postgresql://lurnkode_user:lurnkode_password@localhost:5433/lurnkode_db
# Production: postgresql://user:password@host:5432/lurnkode_db?sslmode=require

# ============================================
# SERVER
# ============================================
PORT=8000
NODE_ENV=development
# NODE_ENV=production

# ============================================
# CORS (chỉ origin cụ thể — KHÔNG dùng *)
# ============================================
ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# JWT — RS256 (M1 là issuer duy nhất)
# ============================================
# Private key để ký JWT (PEM format, base64-encoded để lưu trong env)
# Tạo cặp key: openssl genrsa -out private.pem 2048
#              openssl rsa -in private.pem -pubout -out public.pem
# Encode:      base64 -w 0 private.pem
JWT_PRIVATE_KEY_BASE64=<base64_encoded_private_key_pem>
JWT_PUBLIC_KEY_BASE64=<base64_encoded_public_key_pem>

# Key ID — gắn vào JWT header kid và JWKS
JWT_KEY_ID=m1-auth-key-v1

# JWT issuer — phải khớp với iss claim consumers kiểm tra
JWT_ISSUER=https://lurnkode.local/m1

# JWT audience — phải khớp với aud claim
JWT_AUDIENCE=lurnkode-api

# Access token TTL (giây) — khuyến nghị 900 = 15 phút
JWT_ACCESS_TOKEN_TTL=900

# Refresh token TTL (giây) — khuyến nghị 604800 = 7 ngày
JWT_REFRESH_TOKEN_TTL=604800

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
# LOG_LEVEL=debug  (dùng khi debug local)

