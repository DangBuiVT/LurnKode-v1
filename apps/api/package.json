{
  "name": "@lurnkode/api",
  "version": "0.1.0",
  "private": true,
  "description": "LurnKode M1 Auth and M2 Learning API",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --env-file=.env x drizzle-kit generate",
    "db:migrate": "bun --env-file=.env x drizzle-kit migrate",
    "db:push": "bun --env-file=.env x drizzle-kit push",
    "db:studio": "bun --env-file=.env x drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "jose": "^5.10.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "bun-types": "^1.1.43",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.3"
  }
}
