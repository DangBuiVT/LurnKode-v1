{
  "name": "@lurnkode/api",
  "version": "0.1.0",
  "description": "M1 — Auth Service · Bun + ElysiaJS REST API",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "db:generate": "bun --env-file=.env x drizzle-kit generate",
    "db:migrate": "bun --env-file=.env x drizzle-kit migrate",
    "db:push": "bun --env-file=.env x drizzle-kit push",
    "db:studio": "bun --env-file=.env x drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "elysia": "^1.2.25",
    "@elysiajs/cors": "^1.2.3",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.16.0",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.7.3",
    "bun-types": "^1.1.43"
  }
}

